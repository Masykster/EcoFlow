---
import "../styles/landing.css";

interface Props {
    title?: string;
}

const { title = "EcoFlow - Langkah Kecil untuk Jejak yang Lebih Hijau" } = Astro.props;
---
<!doctype html>
<html lang={"{{ str_replace('_', '-', app()->getLocale()) }}"} class="scroll-smooth">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>{title}</title>

        <link rel="icon" href="/favicon.ico" sizes="any" />
        <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
        <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

        <!-- Fonts: Plus Jakarta Sans -->
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
            rel="stylesheet"
        />

        {/* Laravel runtime: Vite (Livewire / Flux / Chart.js) + Livewire styles.
            Emitted as raw Blade directives into the compiled template. */}
        <Fragment set:html={`@vite(['resources/css/app.css', 'resources/js/app.js'])`} />
        {"@livewireStyles"}
    </head>
    <body class="antialiased bg-[#FAFAFA] selection:bg-[#62F369] selection:text-black">
        <slot />

        {/* Livewire runtime scripts for the guest calculator */}
        {"@livewireScripts"}
    </body>
</html>
